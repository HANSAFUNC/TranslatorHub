# ---------------------------------------------------------------------------
# LocaleHub environment template.
#
# NOTE ON THE FILENAME: this workspace denies reads/writes of `.env*` paths, so the
# template ships as `env.example` and the dev values as `localehub.env`. The config
# loader (@localehub/config) reads, in order:
#     1. $LOCALEHUB_ENV_FILE
#     2. .env            (if the environment allows it)
#     3. localehub.env
# Copy this file to `.env` on a normal workstation, or to `localehub.env` here.
#
# Production deployments must inject secrets from a secret manager / *_FILE
# variables instead of committing them (see docs/DEPLOYMENT.md).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- URLs -------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002
MCP_REMOTE_PORT=3003
# Allowed browser origins. Used by both the CORS middleware and the CSRF guard, so a configured
# value here is also what the guard will accept as `Origin` on state-changing requests.
# Defaults to http://localhost:3000 when unset (or empty).
# To open the stack to other machines on the LAN, list every address a browser will type — an
# address that is not here is refused with 403 CSRF_VERIFICATION_FAILED on login:
#   CORS_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
CORS_ORIGINS=http://localhost:3000
# Leave unset to have the browser call the API on its own origin (recommended: the session cookie
# stays first-party). Set it only when the API lives on a different host than the web app.
# This is inlined into the browser bundle at BUILD time, so for the container image it has to be a
# `docker build --build-arg`; setting it in `docker compose`'s runtime `environment:` does nothing.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# --- transport / browser session -------------------------------------------
# Express `trust proxy`: false (default), true, or a hop count. Only turn this on when a reverse
# proxy really is in front — otherwise X-Forwarded-For can be spoofed to dodge rate limits.
TRUST_PROXY=false
# Refuse credentials over plain HTTP when NODE_ENV=production. Set to true only if a TLS-terminating
# hop you control already protects the connection to this process.
# ALLOW_INSECURE_HTTP=false
SESSION_COOKIE_NAME=localehub_session
CSRF_COOKIE_NAME=localehub_csrf
CSRF_HEADER_NAME=x-csrf-token

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Requests per window for an authenticated actor (interactive session or MCP token).
RATE_LIMIT_MAX=600
# Requests per window for one (IP, account) pair on /auth/login and /auth/register. A second,
# looser bucket per IP (5x) stops password spraying without locking out everyone behind one NAT.
RATE_LIMIT_AUTH_MAX=12

# --- database ---------------------------------------------------------------
# The application connects with a non-owner role so that RLS is enforced.
DATABASE_URL=postgresql://localehub_app:localehub@127.0.0.1:55432/localehub?schema=public
# Migrations run as the owner (Prisma needs DDL rights and a shadow database).
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/localehub?schema=public
TEST_DATABASE_URL=postgresql://localehub_app:localehub@127.0.0.1:55432/localehub_test?schema=public
MIGRATE_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/localehub_test?schema=public

# --- redis / queue ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:56379

# --- secrets (dev only values; override in every real environment) ----------
AUTH_SECRET=dev-only-auth-secret-change-me
ENCRYPTION_KEY=dev-only-encryption-key-change-me
# In production use AUTH_SECRET_FILE=/run/secrets/auth_secret instead:
# AUTH_SECRET_FILE=
# ENCRYPTION_KEY_FILE=
# DATABASE_URL_FILE=
# REDIS_URL_FILE=

# --- MCP --------------------------------------------------------------------
MCP_REMOTE_ENABLED=true
# Externally reachable URL of the Remote MCP; surfaced in the Web UI and in `mcp-config`.
# Behind nginx this is https://<host>/mcp.
MCP_PUBLIC_URL=http://localhost:3003/mcp
# Everything below is read by the CLI (`localehub scan / sync / apply`), which is what touches a
# developer's checkout. There is no local MCP: the platform exposes one MCP and it runs here.
# The CLI reads the platform token from this environment variable name by default:
LOCALEHUB_TOKEN=
LOCALEHUB_API_URL=http://localhost:3001/api/v1
LOCALEHUB_WORKSPACE=

# --- AI ---------------------------------------------------------------------
# Which provider the AI drafting uses. Only these three names do anything:
#   pi        — the machine's own pi install (its providers, its credentials); see PI_* below
#   anthropic — needs ANTHROPIC_API_KEY
#   ollama    — needs OLLAMA_BASE_URL
# Anything else, including this default, falls back to the offline heuristic provider, which does not
# translate: it substitutes glossary terms and echoes the rest.
# AI_DEFAULT_POLICY: pi | anthropic | ollama | heuristic
#
# 只有这四个是 provider。**别的任何值（包括这里曾经写的 `hybrid`）都会落到离线启发式**——
# 它不是"混合"，它只做术语替换、其余原样返回原文，而且以前什么都不说。现在它至少会在启动日志里
# 说一次「AI drafting is not using a model」。
#   pi         读这台机器上已配好的 pi 凭据（不用再发 key）；配 PI_PROVIDER / PI_MODEL
#   anthropic  需要 ANTHROPIC_API_KEY
#   ollama     需要 OLLAMA_BASE_URL
#   heuristic  明确表示"不要模型"（demo/测试用）
AI_DEFAULT_POLICY=heuristic
ANTHROPIC_API_KEY=
# Not read by any provider today — kept only so an old .env does not fail validation.
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- pi provider (only when AI_DEFAULT_POLICY=pi) ---------------------------
# pi needs no key of its own: it reads the credentials the machine already has. What it does need is
# the model to use, from pi's own catalogue (`pi list`, or ~/.pi/agent/models.json):
PI_PROVIDER=gpt-61-sol
PI_MODEL=ctyun/glm-5.3-flash
# Where pi keeps auth.json / models.json. Defaults to pi's own (~/.pi/agent); set it when the process
# runs somewhere that home directory is not.
PI_AGENT_DIR=
# One string should not take a minute: a hung agent is cut off rather than holding the request open.
PI_TIMEOUT_MS=90000
# Where pi's *code* is. The package is ~150 MB (a whole terminal agent), so it is deliberately not a
# dependency of this workspace: point at the pi already installed on this machine instead.
#   PI_SDK_PATH=$(npm root -g)/@earendil-works/pi-coding-agent      # its package directory
#   PI_SDK_PATH=/path/to/pi-coding-agent/dist/index.js              # or the entry file itself
PI_SDK_PATH=

# --- object storage (optional) ---------------------------------------------
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=localehub
S3_REGION=ap-northeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- sync limits ------------------------------------------------------------
SYNC_PLAN_TTL_SECONDS=1800
SYNC_MAX_ENTRIES_PER_BATCH=20000
